# Runtime. Use the exact browser origin (no path).
APP_ENV=local
APP_URL=http://localhost:3000
# Runtime never connects as postgres or the migration owner.
DATABASE_URL=postgresql://app_rw:local_app_only@127.0.0.1:55322/postgres
# Privileged direct connection, used by migrations/local seed only.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
LOG_LEVEL=info

# Isolated disposable PostgreSQL 17; start with `pnpm test:db:up`.
TEST_DATABASE_URL=postgresql://recruiting_test:local_test_only@127.0.0.1:55332/recruiting_test
TEST_DATABASE_RUNTIME_URL=postgresql://app_rw:local_app_only@127.0.0.1:55332/recruiting_test

# Local Supabase CLI only. Google stays disabled until credentials are supplied.
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Auth/storage credentials will become required when T4 is implemented.
# Copy local credentials from `pnpm db:status`; never use hosted production keys locally.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
