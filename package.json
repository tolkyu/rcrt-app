{
  "name": "hris-recruiting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": "11.3.0"
  },
  "scripts": {
    "env:init": "node scripts/env-init.mjs",
    "setup": "pnpm env:init && pnpm install --frozen-lockfile && tsx --env-file-if-exists=.env scripts/setup.ts && pnpm db:start && pnpm db:migrate && pnpm db:provision:local && pnpm db:seed",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e": "playwright test --project=e2e-desktop --project=e2e-mobile --project=e2e-admin-desktop --project=e2e-admin-mobile",
    "test:screens": "playwright test --project=screens-* && node scripts/screenshot-gallery.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env server/db/migrate.ts",
    "db:provision:local": "tsx --env-file-if-exists=.env scripts/provision-local-db.ts",
    "db:seed": "tsx --env-file-if-exists=.env server/db/seed/index.ts",
    "db:seed:auth": "tsx --env-file-if-exists=.env server/db/seed/auth.ts",
    "api:openapi": "tsx --conditions=react-server scripts/openapi.ts",
    "api:postman": "pnpm api:openapi && tsx scripts/postman.ts",
    "perf:size": "node scripts/client-size-config.mjs && size-limit --config .cache/client-size-limit.json",
    "perf:check": "pnpm build && pnpm perf:size"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "6.0.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.14",
    "lucide-react": "1.64.0",
    "next": "15.5.28",
    "next-intl": "4.14.9",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "use-intl": "4.14.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.28",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "openapi-to-postmanv2": "6.4.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "size-limit": "14.3.0",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
